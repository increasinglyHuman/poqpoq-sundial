{
  "name": "@poqpoq/sundial",
  "version": "0.3.0",
  "description": "Sundial: paged (virtual) sun shadows for WebGPU — engine-agnostic core, Babylon.js and three.js adapters, benchmark lab",
  "keywords": [
    "webgpu",
    "shadows",
    "virtual-shadow-maps",
    "shadow-mapping",
    "babylonjs",
    "threejs",
    "wgsl",
    "rendering"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Allen Partridge (p0qp0q)",
  "repository": {
    "type": "git",
    "url": "https://github.com/increasinglyHuman/poqpoq-sundial.git"
  },
  "homepage": "https://github.com/increasinglyHuman/poqpoq-sundial#readme",
  "bugs": {
    "url": "https://github.com/increasinglyHuman/poqpoq-sundial/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./babylon": {
      "types": "./dist/babylon/index.d.ts",
      "import": "./dist/babylon.js"
    },
    "./three": {
      "types": "./dist/three/index.d.ts",
      "import": "./dist/three.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "build:demo": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:consumer": "npm run build && cd test/consumer && npm install --no-audit --no-fund && node probe.mjs",
    "test:consumer-three": "node test/consumer-three/probe.mjs"
  },
  "peerDependencies": {
    "@babylonjs/core": "^9.17.1",
    "three": ">=0.186.0 <0.188.0"
  },
  "peerDependenciesMeta": {
    "@babylonjs/core": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babylonjs/core": "9.17.1",
    "@types/three": "^0.186.0",
    "@webgpu/types": "^0.1.60",
    "playwright-core": "^1.55.0",
    "three": "^0.186.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
